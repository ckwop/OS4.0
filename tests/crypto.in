\ SHA-256, HMAC-SHA-256 and PBKDF2 against Python's hashlib (FIPS 180-4, RFC 4231 and RFC 7914 vectors)
create digest 32 allot
: .digest  ( -- )  base @ hex  32 0 do  digest i + c@ 0 <# # # #> type  loop  base !  space ;
create text 1000 allot
: counting  ( n -- addr n )  dup 0 ?do  i text i + c!  loop  text swap ;
: as  ( n c -- addr n )  text 2 pick rot fill  text swap ;
s" " digest sha256 .digest
s" abc" digest sha256 .digest
1000 counting digest sha256 .digest
55 char a as digest sha256 .digest
56 char a as digest sha256 .digest
64 char a as digest sha256 .digest
create key20 20 allot  key20 20 $0b fill
s" Hi There" key20 20 digest hmac-sha256 .digest
: pass  s" password" ;  : salt  s" salt" ;   \ compiled: interpreted S" strings share one buffer
create key131 131 allot  key131 131 $aa fill
s" Test Using Larger Than Block-Size Key - Hash Key First" key131 131 digest hmac-sha256 .digest
pass salt 1 digest pbkdf2 .digest
pass salt 2 digest pbkdf2 .digest
pass salt 4096 digest pbkdf2 .digest
\ password hashes: salted, so the same password hashes differently
100 hash-iterations !
create pw1 /password allot  create pw2 /password allot
s" swordfish" pw1 hash-password  s" swordfish" pw2 hash-password
s" swordfish" pw1 password? .  s" swordfish" pw2 password? .  s" Swordfish" pw1 password? .
pw1 pw.hash 32 pw2 pw.hash 32 compare 0<> .  pw1 pw.iterations @ .
\ a stored hash with a corrupt count is refused at once: 0 once meant 2^64 iterations under HASH-LOCK
variable answer  -2 answer !  : try ( -- ) s" swordfish" pw1 password? answer ! ;
0 pw1 pw.iterations !  task trier  ' try trier start  1000 ms  answer @ .
max-iterations 1+ pw1 pw.iterations !  s" swordfish" pw1 password? .  -1 pw1 pw.iterations !  s" swordfish" pw1 password? .
pass salt 0 digest ' pbkdf2 catch .  2drop 2drop 2drop
100 pw1 pw.iterations !  s" swordfish" pw1 password? .  s" swordfisH" pw1 password? .
\ every boundary of SHA-256's padding: 55, 56, 63, 64, 65, 119, 120 and 128 bytes
63 char a as digest sha256 .digest
65 char a as digest sha256 .digest
119 char a as digest sha256 .digest
120 char a as digest sha256 .digest
128 char a as digest sha256 .digest
64 counting digest sha256 .digest
\ HMAC keys of 63, 64 (used as they are) and 65 bytes (hashed first)
create key65 65 allot  key65 65 $aa fill
s" abc" key65 63 digest hmac-sha256 .digest
s" abc" key65 64 digest hmac-sha256 .digest
s" abc" key65 65 digest hmac-sha256 .digest
text 0 key65 64 digest hmac-sha256 .digest
100 char a as s" key" digest hmac-sha256 .digest
\ PBKDF2 with a password longer than a block, and a salt that spills into a second block
create pw70 70 allot  pw70 70 char p fill  create s60 60 allot  s60 60 char s fill
pw70 70 s60 60 3 digest pbkdf2 .digest
pw70 64 s60 55 1 digest pbkdf2 .digest
